# WorkSphere Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String:
# Local development format: postgresql://postgres:password@localhost:5432/worksphere?schema=public
# Production format (Render/Railway/Supabase): postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/worksphere?schema=public"

# Secret key for signing JSON Web Tokens (use a strong random 32+ character string in production)
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"
JWT_EXPIRES_IN="7d"

# Allowed CORS origin (URL of the frontend web application)
CORS_ORIGIN="http://localhost:5173"
