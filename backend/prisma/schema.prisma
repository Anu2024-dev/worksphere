generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  AGENT
  ADMIN
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_EMPLOYEE
  RESOLVED
  CLOSED
  REOPENED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  REQUEST_CREATED
  REQUEST_ASSIGNED
  REQUEST_STATUS_UPDATED
  REQUEST_COMMENT
  TASK_ASSIGNED
  TASK_STATUS_UPDATED
  TASK_COMMENT
  TASK_DEADLINE_APPROACHING
  TASK_OVERDUE
  SLA_BREACH_WARNING
  SLA_BREACHED
  SYSTEM
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           Role           @default(EMPLOYEE)
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  avatarUrl      String?
  jobTitle       String?
  phone          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  teamMemberships        TeamMember[]
  createdRequests        ServiceRequest[]       @relation("CreatedRequests")
  assignedRequests       ServiceRequest[]       @relation("AssignedRequests")
  requestComments        RequestComment[]
  requestActivities      RequestActivity[]
  givenRequestAssigns    RequestAssignment[]    @relation("AssignerAssignments")
  receivedRequestAssigns RequestAssignment[]    @relation("AssigneeAssignments")
  uploadedRequestFiles   RequestAttachment[]

  createdTasks           Task[]                 @relation("CreatedTasks")
  assignedTasks          Task[]                 @relation("AssignedTasks")
  taskComments           TaskComment[]
  taskActivities         TaskActivity[]
  givenTaskAssigns       TaskAssignmentHistory[] @relation("TaskAssignerHistory")
  receivedTaskAssigns    TaskAssignmentHistory[] @relation("TaskAssigneeHistory")
  uploadedTaskFiles      TaskAttachment[]

  notifications          Notification[]
  auditLogs              AuditLog[]

  @@index([role])
  @@index([departmentId])
  @@index([email])
}

model Department {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  teams       Team[]
  categories  RequestCategory[]
  requests    ServiceRequest[]
  tasks       Task[]
}

model Team {
  id           String       @id @default(uuid())
  name         String
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members      TeamMember[]

  @@index([departmentId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // LEAD, MEMBER
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model RequestCategory {
  id                   String           @id @default(uuid())
  name                 String           @unique
  description          String?
  defaultDepartmentId  String?
  defaultDepartment    Department?      @relation(fields: [defaultDepartmentId], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  serviceRequests      ServiceRequest[]
}

model SLAPolicy {
  id                   String          @id @default(uuid())
  priority             RequestPriority @unique
  responseTimeHours    Int             // Hours allowed for first response
  resolutionTimeHours  Int             // Hours allowed for full resolution
  isBusinessHours      Boolean         @default(false) // Clearly document business vs calendar hours
  description          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model ServiceRequest {
  id                  String             @id @default(uuid())
  requestId           String             @unique // E.g., WRK-2026-0001
  title               String
  description         String             @db.Text
  categoryId          String
  category            RequestCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory         String?
  departmentId        String?
  department          Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  priority            RequestPriority    @default(MEDIUM)
  status              RequestStatus      @default(OPEN)
  contactInfo         String?

  creatorId           String
  creator             User               @relation("CreatedRequests", fields: [creatorId], references: [id], onDelete: Restrict)

  assignedAgentId     String?
  assignedAgent       User?              @relation("AssignedRequests", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  responseDeadline    DateTime?
  resolutionDeadline  DateTime?
  firstRespondedAt    DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  reopenedAt          DateTime?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  comments            RequestComment[]
  activities          RequestActivity[]
  assignments         RequestAssignment[]
  attachments         RequestAttachment[]
  linkedTasks         Task[]             @relation("ServiceRequestTasks")

  @@index([requestId])
  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([assignedAgentId])
  @@index([departmentId])
  @@index([createdAt])
}

model RequestComment {
  id               String         @id @default(uuid())
  requestId        String
  request          ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId         String
  author           User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content          String         @db.Text
  isInternal       Boolean        @default(false) // Internal note: strictly hidden from employees!
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([requestId])
  @@index([authorId])
  @@index([isInternal])
}

model RequestActivity {
  id          String         @id @default(uuid())
  requestId   String
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action      String         // CREATED, ASSIGNED, STATUS_CHANGED, PRIORITY_CHANGED, COMMENT_ADDED, RESOLVED, REOPENED, CLOSED, TASK_LINKED
  field       String?
  oldValue    String?
  newValue    String?
  note        String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([requestId])
  @@index([actorId])
  @@index([createdAt])
}

model RequestAssignment {
  id                  String         @id @default(uuid())
  requestId           String
  request             ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignerId          String
  assigner            User           @relation("AssignerAssignments", fields: [assignerId], references: [id], onDelete: Restrict)
  assigneeId          String
  assignee            User           @relation("AssigneeAssignments", fields: [assigneeId], references: [id], onDelete: Restrict)
  previousAssigneeId  String?
  reason              String?
  createdAt           DateTime       @default(now())

  @@index([requestId])
  @@index([assigneeId])
}

model RequestAttachment {
  id          String         @id @default(uuid())
  requestId   String
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileType    String?
  fileSize    Int?
  uploaderId  String
  uploader    User           @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())

  @@index([requestId])
}

model Task {
  id                String                  @id @default(uuid())
  taskNumber        String                  @unique // E.g., TSK-1001
  title             String
  description       String?                 @db.Text
  taskType          String                  @default("GENERAL") // GENERAL, BUG, FEATURE, SUPPORT_WORK, INVESTIGATION
  priority          TaskPriority            @default(MEDIUM)
  status            TaskStatus              @default(TODO)
  departmentId      String?
  department        Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  creatorId         String
  creator           User                    @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Restrict)

  assigneeId        String?
  assignee          User?                   @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  startDate         DateTime?
  dueDate           DateTime?
  estimatedHours    Float?
  labels            String[]                @default([])

  // Optional integration link to a Service Request:
  serviceRequestId  String?
  serviceRequest    ServiceRequest?         @relation("ServiceRequestTasks", fields: [serviceRequestId], references: [id], onDelete: SetNull)

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  comments          TaskComment[]
  activities        TaskActivity[]
  assignmentHistory TaskAssignmentHistory[]
  attachments       TaskAttachment[]

  @@index([taskNumber])
  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([departmentId])
  @@index([serviceRequestId])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([authorId])
}

model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String   // CREATED, ASSIGNED, STATUS_CHANGED, PRIORITY_CHANGED, COMMENT_ADDED, DATES_CHANGED, LINKED_TO_REQUEST
  field     String?
  oldValue  String?
  newValue  String?
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([actorId])
  @@index([createdAt])
}

model TaskAssignmentHistory {
  id                 String   @id @default(uuid())
  taskId             String
  task               Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignerId         String
  assigner           User     @relation("TaskAssignerHistory", fields: [assignerId], references: [id], onDelete: Restrict)
  assigneeId         String
  assignee           User     @relation("TaskAssigneeHistory", fields: [assigneeId], references: [id], onDelete: Restrict)
  previousAssigneeId String?
  createdAt          DateTime @default(now())

  @@index([taskId])
  @@index([assigneeId])
}

model TaskAttachment {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileType    String?
  fileSize    Int?
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([taskId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?          // e.g. /requests/WRK-2026-0001 or /tasks/TSK-1001
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // E.g. USER_LOGIN, ROLE_CHANGED, POLICY_UPDATED
  entityType String   // USER, REQUEST, TASK, POLICY, SYSTEM
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}
